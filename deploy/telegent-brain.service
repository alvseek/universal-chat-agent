[Unit]
Description=telegent brain (universal-chat-agent) — chat agent HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/universal-chat-agent
ExecStart=/home/deploy/universal-chat-agent/.venv/bin/uvicorn application.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3
# Protect the shared 1 GB box: cap telegent so a leak can never starve invintiry.
MemoryMax=450M

[Install]
WantedBy=multi-user.target

# Copy this file to `.env` and fill it in. NEVER commit `.env`.

# --- Model (OpenRouter, OpenAI-compatible) ---
# Your OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id on OpenRouter — swap to any model you like.
OPENROUTER_MODEL=deepseek/deepseek-chat

# OpenAI-compatible base URL for OpenRouter (usually leave as-is).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Behaviour ---
# How many recent messages (user + assistant) to remember per conversation.
MEMORY_WINDOW=15

# Where the SQLite memory database lives.
DB_PATH=agent.db

# The agent's persona / system prompt.
SYSTEM_PROMPT=You are a helpful, friendly assistant. Be concise and clear.

# --- HTTP server ---
# Host/port the brain listens on (bridges POST /chat here).
HOST=0.0.0.0
PORT=8000

# --- Memory service (optional) ---
# Leave MUNNIN_URL empty and the brain is the single agent above (SYSTEM_PROMPT).
# Set it and a request may name an agent_id: the brain awakens that agent from the
# memory service and answers as it. The credential is a machine client registered
# at the identity provider (OAuth client_credentials, token bound to MUNNIN_RESOURCE).
MUNNIN_URL=
# Defaults to <MUNNIN_URL>/mcp — must match the API resource registered at the issuer.
MUNNIN_RESOURCE=
MUNNIN_M2M_CLIENT_ID=
MUNNIN_M2M_CLIENT_SECRET=
MUNNIN_M2M_SCOPE=
# The issuer's OIDC base, e.g. https://auth.example/oidc (token endpoint = issuer + /token).
AUTHENTRA_ISSUER=

# --- Toolsets (optional; needs the memory service above) ---
# Which named toolsets each agent is bound to: comma-separated agent=toolset pairs
# (e.g. invintiry-operator=invintiry). Code owns what a toolset does; this line owns
# who gets it. An unbound agent has no tools — and its prompt says so.
AGENT_TOOLSETS=

# The invintiry toolset's backing API, and the brain's OWN credential.
#
# INVINTIRY_BRAIN_TOKEN is used for exactly one call — redeeming a link code —
# which happens before the person has any token of their own. Everything else
# runs on the caller's token, which they get by connecting their account
# (invintiry -> Settings -> Telegram) and which is stored per person, not here.
#
# Mint it once as an OWNER: POST /api/agent-tokens/ via Swagger. It is shown
# once and never retrievable, and it is deliberately not workspace-scoped, so a
# single credential can redeem codes for any workspace.
INVINTIRY_API_URL=
INVINTIRY_BRAIN_TOKEN=
# How long a built agent stays warm before its awakening is fetched again (seconds).
AGENT_CACHE_TTL_SECONDS=28800
# Which awakening layers become the system prompt, in order (comma-separated dotted
# names, e.g. identity,shared.reasoning). Empty = every layer, canonical order.
AWAKENING_LAYERS=
# Layers to leave out (comma-separated). Empty = none.
AWAKENING_EXCLUDE=

# Copy this file to `.env` and fill it in. NEVER commit `.env`.

# --- Model (any OpenAI-compatible endpoint) ---
# API key for that endpoint. The default endpoint below is OpenRouter, whose keys
# live at https://openrouter.ai/keys — point LLM_BASE_URL elsewhere for another.
LLM_API_KEY=

# Model id at that endpoint — swap to any model you like.
LLM_MODEL=deepseek/deepseek-chat

# The endpoint. Any OpenAI-compatible API works; OpenRouter is the default.
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Behaviour ---
# How many recent messages (user + assistant) to remember per conversation.
MEMORY_WINDOW=15

# Where the SQLite memory database lives.
DB_PATH=agent.db

# The agent's persona / system prompt.
SYSTEM_PROMPT=You are a helpful, friendly assistant. Be concise and clear.

# --- HTTP server ---
# Host/port the brain listens on (bridges POST /chat here).
HOST=0.0.0.0
PORT=8000

# --- Memory service (optional) ---
# Leave MEMORY_SERVICE_URL empty and the brain is the single agent above (SYSTEM_PROMPT).
# Set it and a request may name an agent_id: the brain awakens that agent from the
# memory service and answers as it. The credential is a machine client registered
# at the identity provider (OAuth client_credentials, token bound to MEMORY_SERVICE_RESOURCE).
MEMORY_SERVICE_URL=
# Defaults to <MEMORY_SERVICE_URL>/mcp — must match the API resource registered at the issuer.
MEMORY_SERVICE_RESOURCE=
MEMORY_SERVICE_CLIENT_ID=
MEMORY_SERVICE_CLIENT_SECRET=
MEMORY_SERVICE_SCOPE=
# The issuer's OIDC base, e.g. https://auth.example/oidc (token endpoint = issuer + /token).
OIDC_ISSUER=

# --- Toolsets and linking (optional; both need the memory service above) ---
# Which named toolsets each agent is bound to: comma-separated agent=toolset pairs
# (e.g. my-agent=my-toolset). Code owns what a toolset does; this line owns who
# gets it. An unbound agent has no tools — and its prompt says so.
AGENT_TOOLSETS=

# Where each toolset's builder lives: comma-separated alias=module:attribute.
# The brain bundles no integration of its own, so a toolset it does not ship is
# named here and imported at startup — a bad path fails the boot, not a turn.
# e.g. my-toolset=my_integration.toolsets:build
TOOLSET_SOURCES=

# Where each account-linking provider lives, in the same alias=module:attribute
# form. Linking lets a person connect their own account to the agent, and a
# provider reads its own service's settings — so the brain never learns which
# services exist. e.g. my-service=my_integration.link:build_provider
LINK_PROVIDERS=
# How long a built agent stays warm before its awakening is fetched again (seconds).
AGENT_CACHE_TTL_SECONDS=28800
# Which awakening layers become the system prompt, in order (comma-separated dotted
# names, e.g. identity,shared.reasoning). Empty = every layer, canonical order.
AWAKENING_LAYERS=
# Layers to leave out (comma-separated). Empty = none.
AWAKENING_EXCLUDE=
